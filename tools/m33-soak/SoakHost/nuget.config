<?xml version="1.0" encoding="utf-8"?>
<!-- Same feed shape as samples/nuget.config: pack locally first
       dotnet pack src/CredProx -c Release -o artifacts/packages
     The container build gets the packages through the named build context "pkgs". -->
<configuration>
  <packageSources>
    <clear />
    <add key="credprox-local" value="../../../artifacts/packages" />
    <add key="credprox-image" value="/pkgs" />
  </packageSources>
</configuration>
