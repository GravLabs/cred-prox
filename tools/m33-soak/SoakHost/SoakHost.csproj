<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The M33 soak host (plan §5.5): the proxy under test. Not part of the solution and
       never packed; it consumes CredProx exactly like samples/ do, from the local feed. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CREDPROX001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CredProx" Version="0.9.1" />
    <!-- Fault 6 (design decision 2026-11-08): the REAL Key Vault config provider,
         same package + 1.3.x line the shipped ACA hosts use. Only the transport is swapped
         to the loopback stub (M29 reloadproof pattern); provider, SecretClient and the
         ReloadInterval polling loop run exactly as shipped. -->
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.3.2" />
  </ItemGroup>

</Project>
