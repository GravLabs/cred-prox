<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The M33 soak host (plan §5.5): the proxy under test. Not part of the solution and
       never packed; it consumes CredProx exactly like samples/ do, from the local feed. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CREDPROX001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- $(Version) flows from build/Version.props through this host's props import:
         the soak host always takes the repository's current version from the local
         feed, so a version bump cannot strand it again. -->
    <PackageReference Include="CredProx" Version="$(Version)" />
    <!-- Throttling/Resilience/Health moved out of the core in this dev line, so the
         host takes them from CredProx.Operations at the same version. -->
    <PackageReference Include="CredProx.Operations" Version="$(Version)" />
    <!-- The soak config names OAuthClientCredentials and LoginExchange credentials; since
         ADR-0005 those credential types ship in their own packages, so the host takes them
         from the same feed at the same version. SoakHostCredentialPackagePinTests pins that
         every Type the config names has its reference and its registration here. -->
    <PackageReference Include="CredProx.Identity" Version="$(Version)" />
    <!-- The soak config admits callers by key (CredProx:Callers + the X-CredProx-Key
         header CallerKeyOptions defaults to, sent by k6/soak.js): caller keys ride the
         core entry from 0.15, exactly like a real enforcing host. The pin test keeps
         config, references and setup calls from drifting apart again. -->
    <!-- Fault 6 (design decision 2026-11-08): the REAL Key Vault config provider,
         same package + 1.3.x line the shipped ACA hosts use. Only the transport is swapped
         to the loopback stub (M29 reloadproof pattern); provider, SecretClient and the
         ReloadInterval polling loop run exactly as shipped. -->
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.3.2" />
  </ItemGroup>

</Project>
