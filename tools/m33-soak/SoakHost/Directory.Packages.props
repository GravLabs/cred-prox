<Project>
  <!-- Stops the upward walk to the repo-root CPM file: the soak host carries its own
       explicit references, versioned to the repository's current $(Version) — it tests
       the bytes this tree packs, the same local-feed route the samples take. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
