{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CredProx": {
    "Callers": {
      "caller-a": {
        "Keys": [ { "KeyId": "caller-a-key-1", "KeyHash": "KEYHASH_A" } ],
        "Operations": [
          { "Route": "gen1", "Methods": [ "GET" ] },
          { "Route": "gen2", "Methods": [ "GET" ] },
          { "Route": "cc", "Methods": [ "GET" ] },
          { "Route": "sse", "Methods": [ "GET" ] }
        ]
      },
      "caller-b": {
        "Keys": [ { "KeyId": "caller-b-key-1", "KeyHash": "KEYHASH_B" } ],
        "Operations": [
          { "Route": "gen1", "Methods": [ "GET" ] },
          { "Route": "cc", "Methods": [ "GET" ] }
        ]
      },
      "caller-c": {
        "Keys": [ { "KeyId": "caller-c-key-1", "KeyHash": "KEYHASH_C" } ],
        "Operations": [
          { "Route": "login-api", "Methods": [ "GET" ] }
        ]
      }
    },
    "Destinations": {
      "vendor": { "Template": "http://toxiproxy:8004" },
      "idp": { "Template": "http://toxiproxy:8003" }
    },
    "Credentials": {
      "vendor-gen1": {
        "Type": "StaticKey",
        "Secret": "secret:vendor-gen1-key",
        "Location": "Header",
        "Name": "X-Vendor-Key"
      },
      "vendor-gen2": {
        "Type": "StaticKey",
        "Secret": "secret:vendor-gen2-key",
        "Location": "Header",
        "Name": "X-Vendor-Key"
      },
      "stream": {
        "Type": "StaticKey",
        "Secret": "secret:stream-key",
        "Location": "Header",
        "Name": "X-Stream-Key"
      },
      "idp-cc": {
        "Type": "OAuthClientCredentials",
        "TokenEndpoint": "http://toxiproxy:8003/idp/token",
        "ClientId": "soak-client",
        "ClientSecret": "secret:idp-client-secret",
        "TokenTypeName": "Bearer"
      },
      "login-acme": {
        "Type": "LoginExchange",
        "LoginEndpoint": "http://toxiproxy:8003/login/{partition}/login",
        "Method": "POST",
        "Form": {
          "User": "{partition}-svc",
          "Password": "secret:login-password"
        },
        "Response": "JsonPath",
        "ResponseField": "sessionId",
        "Lifetime": "00:02:00",
        "Partition": {
          "From": "header:X-API-Env",
          "Allowed": [ "prod" ]
        }
      }
    },
    "Secrets": {
      "vendor-gen1-key": "SEC_GEN1",
      "vendor-gen2-key": "SEC_GEN2",
      "stream-key": "SEC_STREAM",
      "idp-client-secret": "SEC_IDP",
      "login-password": "SEC_LOGIN"
    },
    "Throttling": {
      "Clusters": {
        "vendor": { "PermitsPerInterval": 100, "Interval": "00:00:01", "QueueLimit": 20 }
      }
    },
    "Resilience": {
      "MaxRetries": 0,
      "Clusters": {
        "vendor": {
          "FailureRatio": 0.5,
          "MinimumThroughput": 4,
          "SamplingDuration": "00:00:10",
          "BreakDuration": "00:00:05"
        }
      }
    },
    "Audit": {
      "Enabled": true
    }
  },
  "ReverseProxy": {
    "Routes": {
      "gen1": {
        "ClusterId": "vendor",
        "Match": { "Path": "/vendor/{**rest}" },
        "Transforms": [ { "PathPattern": "/gen1/{**rest}" } ],
        "Metadata": {
          "CredProx.Destination": "vendor",
          "CredProx.Credential": "vendor-gen1"
        }
      },
      "gen2": {
        "ClusterId": "vendor",
        "Match": { "Path": "/vendor2/{**rest}" },
        "Transforms": [ { "PathPattern": "/gen2/{**rest}" } ],
        "Metadata": {
          "CredProx.Destination": "vendor",
          "CredProx.Credential": "vendor-gen2"
        }
      },
      "cc": {
        "ClusterId": "vendor",
        "Match": { "Path": "/cc/{**rest}" },
        "Transforms": [ { "PathPattern": "/cc/{**rest}" } ],
        "Metadata": {
          "CredProx.Destination": "vendor",
          "CredProx.Credential": "idp-cc"
        }
      },
      "sse": {
        "ClusterId": "vendor",
        "Match": { "Path": "/sse/{**rest}" },
        "Transforms": [ { "PathPattern": "/sse/{**rest}" } ],
        "Metadata": {
          "CredProx.Destination": "vendor",
          "CredProx.Credential": "stream"
        }
      },
      "login-api": {
        "ClusterId": "vendor",
        "Match": { "Path": "/login-api/{**rest}" },
        "Transforms": [ { "PathPattern": "/gen1/{**rest}" } ],
        "Metadata": {
          "CredProx.Destination": "vendor",
          "CredProx.Credential": "login-acme"
        }
      }
    },
    "Clusters": {
      "vendor": {
        "Destinations": {
          "vendor": { "Address": "http://toxiproxy:8004/" }
        }
      }
    }
  }
}
