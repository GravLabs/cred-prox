<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Add-on for CredProx: caller API keys (ADR-0005). Callers present hashed API keys under their own scheme; the core carries the caller policy — the registry, operation rules, budgets and the kill switch — and knows nothing about keys. Same configuration keys (CredProx:CallerAuth, CredProx:Callers:&lt;id&gt;:Keys), same scheme name, same guarantees; the host adds a package reference — the registration call AddCredProxCallerAuthentication is unchanged.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CredProx\CredProx.csproj" />
    <ProjectReference Include="..\CredProx.Abstractions\CredProx.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CredProx.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The add-on dogfoods the experimental plugin contract (plan §3.5 rule 2). -->
    <NoWarn>$(NoWarn);CREDPROX001</NoWarn>
  </PropertyGroup>

</Project>
