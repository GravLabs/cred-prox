<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Add-on for CredProx: the LoginExchange credential type (ADR-0005). The login-exchange provider, its options and its startup validator move out of the core; the host adds a package reference and calls AddCredProxLoginExchange. Same configuration keys (CredProx:Credentials:&lt;id&gt; with Type: LoginExchange), same exchange semantics — per-request template expansion through the core's shared expander, token cached per (credential, partition), failures never naming secret values or response bodies; the core carries the pipeline, the template rules and the named HttpClient.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CredProx\CredProx.csproj" />
    <ProjectReference Include="..\CredProx.Abstractions\CredProx.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CredProx.Tests" />
    <InternalsVisibleTo Include="CredProx.Fuzz" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The add-on dogfoods the experimental plugin contract (plan §3.5 rule 2). -->
    <NoWarn>$(NoWarn);CREDPROX001</NoWarn>
    <!-- New package: no published baseline exists yet, so baseline validation is skipped;
         its rotation starts at 0.12.0 (ADR-0001). -->
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>

</Project>
