<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Add-on for CredProx: the operations features (ADR-0005). The outbound throttle (per-cluster rate and concurrency limits, bounded queue, vendor-429 pause), the resilience adapter (attempt timeout, retry, circuit breaker) and the health probes (credential token-obtainable, certificate expiry) move out of the core with their options, validators and pipeline features; the host adds a package reference and calls AddCredProxThrottling, AddCredProxResilience and AddCredProxHealthProbes. Same configuration keys (CredProx:Throttling, CredProx:Resilience, CredProx:Health), same guarantees — pipeline order by Stage and Order, the credprox problem responses, eager options validation at startup; caller budgets and the kill switch stay core caller policy.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CredProx\CredProx.csproj" />
    <ProjectReference Include="..\CredProx.Abstractions\CredProx.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The resilience adapter builds its pipelines on the Microsoft resilience library. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <!-- The health probe endpoint registration (AddHealthChecks/AddCheck). -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <!-- The background probe service. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CredProx.Tests" />
    <InternalsVisibleTo Include="CredProx.LoadTests" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The add-on dogfoods the experimental plugin contract (plan §3.5 rule 2). -->
    <NoWarn>$(NoWarn);CREDPROX001</NoWarn>
    <!-- New package: no published baseline exists yet, so baseline validation is skipped;
         its rotation starts at 0.12.0 (ADR-0001). -->
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>

</Project>
