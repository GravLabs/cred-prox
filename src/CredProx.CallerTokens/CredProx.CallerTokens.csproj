<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Add-on for CredProx: caller tokens (ADR-0004). Agents present short-lived OIDC access tokens instead of stored secrets — the stock JWT bearer handler validates them under the caller-token scheme, Entra app roles narrow the caller to its named operation rules, and MaxTokenAge caps token age from iat.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CredProx\CredProx.csproj" />
    <ProjectReference Include="..\CredProx.Abstractions\CredProx.Abstractions.csproj" />
    <!-- The stock JWT bearer handler for caller tokens travels with this package (M39,
         ADR-0004); .NET 10 moved it out of Microsoft.AspNetCore.App. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CredProx.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The add-on dogfoods the experimental plugin contract (plan §3.5 rule 2). -->
    <NoWarn>$(NoWarn);CREDPROX001</NoWarn>
    <!-- New package: no published baseline exists yet, so baseline validation is skipped;
         its rotation starts at 0.12.0 (ADR-0001). -->
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>

</Project>
