{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CredProx": {
    "Destinations": {
      "api": { "Template": "http://api:8080" }
    },
    "Credentials": {
      "keycloak": {
        "Type": "OAuthClientCredentials",
        "TokenEndpoint": "http://keycloak:8080/realms/credprox/protocol/openid-connect/token",
        "ClientId": "credprox-api",
        "ClientSecret": "secret:keycloak-secret",
        "TokenTypeName": "Bearer"
      }
    },
    "Secrets": {
      "keycloak-secret": "credprox-api-secret"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "api",
        "Match": { "Path": "/{**catch-all}" },
        "Metadata": {
          "CredProx.Destination": "api",
          "CredProx.Credential": "keycloak"
        }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "api": { "Address": "http://api:8080/" }
        }
      }
    }
  }
}
