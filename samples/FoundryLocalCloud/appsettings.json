{
  "//": "Local plus cloud behind one CredProx front. The local route (foundry) is a Foundry Local server on loopback: OpenAI wire format, no credential, the caller's X-CredProx-Key is the only authentication on that path. The cloud route (anthropic) is an Anthropic Messages call behind a StaticKey header credential no app ever holds, metered with the anthropic usage format. Which caller may take which route is its Operations list (absent = every operation) - the choice is config, never code, and there is no failover: a dead local model fails the local call, it does not reroute to the cloud. Demo keys are throwaway; real ones go in your secret source.",
  "Urls": "http://localhost:5106",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CredProx": {
    "Callers": {
      "local-app": {
        "Keys": [
          { "KeyId": "local-app-key-1", "KeyHash": "sha256:7a220b5cc72832633be4d48457b3e6d357672a2904d24189a6582b9991ffa741" }
        ],
        "Operations": [
          { "Route": "foundry", "Methods": [ "POST" ], "Paths": [ "/gateway/v1/chat/**" ] }
        ]
      },
      "dual-app": {
        "Keys": [
          { "KeyId": "dual-app-key-1", "KeyHash": "sha256:7de85ca5e63220ddcd5ee701b856b8d44f1425370d1e6a4ad8f25fa3fb000460" }
        ],
        "Operations": [
          { "Route": "foundry", "Methods": [ "POST" ], "Paths": [ "/gateway/v1/chat/**" ] },
          { "Route": "anthropic", "Methods": [ "POST" ], "Paths": [ "/cloud/v1/messages/**" ] }
        ]
      }
    },
    "Destinations": {
      "foundry": { "Template": "http://127.0.0.1:5273" },
      "anthropic": { "Template": "https://api.anthropic.com" }
    },
    "Credentials": {
      "anthropic-cloud": {
        "Type": "StaticKey",
        "Secret": "secret:anthropic-cloud-key",
        "Location": "Header",
        "Name": "x-api-key"
      }
    },
    "Secrets": {
      "anthropic-cloud-key": "credprox-demo-cloud-key"
    },
    "Audit": {
      "Enabled": true
    },
    "Metering": {
      "MaxUsageParseBytes": 1048576
    }
  },
  "Metrics": {
    "//": "Console true prints the CredProx meter to stdout instead of exporting OTLP (the default endpoint OTEL_EXPORTER_OTLP_ENDPOINT). Shorten OTEL_METRIC_EXPORT_INTERVAL (ms, default 60000) for demos.",
    "Console": false
  },
  "ReverseProxy": {
    "Routes": {
      "foundry": {
        "ClusterId": "foundry",
        "Match": { "Path": "/gateway/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/gateway" } ],
        "Metadata": {
          "CredProx.Destination": "foundry",
          "CredProx.Metering.Usage": "openai"
        }
      },
      "anthropic": {
        "ClusterId": "anthropic",
        "Match": { "Path": "/cloud/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/cloud" },
          { "RequestHeader": "anthropic-version", "Set": "2023-06-01" }
        ],
        "Metadata": {
          "CredProx.Credential": "anthropic-cloud",
          "CredProx.Destination": "anthropic",
          "CredProx.Metering.Usage": "anthropic"
        }
      }
    },
    "Clusters": {
      "foundry": {
        "Destinations": {
          "foundry": { "Address": "http://127.0.0.1:5273/" }
        }
      },
      "anthropic": {
        "Destinations": {
          "anthropic": { "Address": "https://api.anthropic.com/" }
        }
      }
    }
  }
}
