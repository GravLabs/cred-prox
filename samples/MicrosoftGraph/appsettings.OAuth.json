{
  // The client-credentials variant's credential, loaded by Program.cs unless
  // --variant identity is given. Replace <tenant-id> and set ClientId plus
  // CredProx__Secrets__graph-client-secret (env vars override these placeholders).
  "CredProx": {
    "Credentials": {
      "graph": {
        "Type": "OAuthClientCredentials",
        "TokenEndpoint": "https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token",
        "ClientId": "",
        "Scope": "https://graph.microsoft.com/.default",
        "ClientAuthentication": "BasicHeader",
        "ClientSecret": "secret:graph-client-secret"
      }
    }
  }
}
