{
  // The secretless variant: the TokenCredential type takes the ambient Azure identity —
  // no client secret, no token endpoint. It declares only the keys TokenCredential owns;
  // the OAuth fields live in appsettings.OAuth.json, which this variant never loads.
  "CredProx": {
    "Credentials": {
      "graph": {
        "Type": "TokenCredential",
        "Scope": "https://graph.microsoft.com/.default"
      }
    }
  }
}
