{
  "mappings": [
    {
      "request": {
        "method": "POST",
        "urlPath": "/fake-tenant/oauth2/v2.0/token",
        "basicAuthCredentials": { "username": "demo-client", "password": "demo-secret" },
        "bodyPatterns": [
          { "matches": "(?s).*grant_type=client_credentials(?:&.*)?" }
        ]
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "access_token": "mg-stub-token",
          "expires_in": 3600,
          "token_type": "Bearer"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "urlPathPattern": "/v1\\.0/.*"
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "text/plain" },
        "body": "graph saw: {{request.headers.Authorization}}",
        "transformers": ["response-template"]
      }
    }
  ]
}
