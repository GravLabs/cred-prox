{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CredProx": {
    "Destinations": {
      "graph": { "Template": "https://graph.microsoft.com" }
    },
    // The credential itself lives in the variant file: appsettings.OAuth.json for the
    // client-credentials run, appsettings.ManagedIdentity.json for --variant identity.
    // Each variant declares only the keys its credential Type owns — CredProx rejects
    // keys the active type does not declare, so they cannot be layered across variants.
    "Secrets": {
      "graph-client-secret": ""
    }
  },
  "ReverseProxy": {
    "Routes": {
      "graph": {
        "ClusterId": "graph",
        "Match": { "Path": "/graph/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/graph" }
        ],
        "Metadata": {
          "CredProx.Destination": "graph",
          "CredProx.Credential": "graph"
        }
      }
    },
    "Clusters": {
      "graph": {
        "Destinations": {
          "graph": { "Address": "https://graph.microsoft.com/" }
        }
      }
    }
  }
}
