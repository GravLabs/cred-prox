{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5085",
  "CredProx": {
    "Destinations": {
      "graph": { "Template": "https://graph.microsoft.com" }
    },
    // The credential itself lives in the style file: appsettings.OAuth.json for the
    // client-secret run (ASPNETCORE_ENVIRONMENT=OAuth), appsettings.ManagedIdentity.json
    // for the secretless run (=ManagedIdentity). Each style file declares only the keys
    // its credential Type owns — CredProx rejects keys the active type does not declare,
    // so the two styles cannot be layered on top of each other.
    "Secrets": {
      "graph-client-secret": ""
    }
  },
  "ReverseProxy": {
    "Routes": {
      "graph": {
        "ClusterId": "graph",
        "Match": { "Path": "/graph/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/graph" }
        ],
        "Metadata": {
          "CredProx.Destination": "graph",
          "CredProx.Credential": "graph"
        }
      }
    },
    "Clusters": {
      "graph": {
        "Destinations": {
          "graph": { "Address": "https://graph.microsoft.com/" }
        }
      }
    }
  }
}
