{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CredProx": {
    "Destinations": {
      "echo": {
        "Template": "https://postman-echo.com"
      }
    },
    "Credentials": {
      "echo-key": {
        "Type": "StaticKey",
        "Name": "X-API-Key",
        "Secret": "secret:echo-key"
      }
    },
    "Secrets": {
      "echo-key": "demo-static-key"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "echo": {
        "ClusterId": "echo",
        "Match": {
          "Path": "/echo/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/echo" }
        ],
        "Metadata": {
          "CredProx.Destination": "echo",
          "CredProx.Credential": "echo-key"
        }
      }
    },
    "Clusters": {
      "echo": {
        "Destinations": {
          "echo": {
            "Address": "https://postman-echo.com/"
          }
        }
      }
    }
  }
}
