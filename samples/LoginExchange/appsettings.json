{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CredProx": {
    "Destinations": {
      "acme": { "Template": "http://localhost:8082" }
    },
    "Credentials": {
      "acme": {
        "Type": "LoginExchange",
        "LoginEndpoint": "http://localhost:8082/acme/{partition}/login",
        "Method": "POST",
        "Form": { "User": "{partition}-svc", "Password": "secret:acme-password" },
        "Response": "JsonPath",
        "ResponseField": "sessionId",
        "Lifetime": "01:00:00",
        "Partition": {
          "From": "header:X-API-Env",
          "Allowed": ["uat", "staging"]
        }
      }
    },
    "Secrets": {
      "acme-password": "demo-acme-password"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "acme": {
        "ClusterId": "acme",
        "Match": { "Path": "/acme/{**catch-all}" },
        "Metadata": {
          "CredProx.Destination": "acme",
          "CredProx.Credential": "acme"
        }
      }
    },
    "Clusters": {
      "acme": {
        "Destinations": { "acme": { "Address": "http://localhost:8082/" } }
      }
    }
  }
}
