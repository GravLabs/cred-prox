{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CredProx": {
    "Callers": {
      "crm-agent": {
        "Keys": [
          { "KeyId": "crm-agent-key-1", "KeyHash": "sha256:0c06554aadf722510d11e39609cb850f4b026fea2b0968af10a3d399d04b3bae" }
        ],
        "Operations": [
          { "Route": "salesforce", "Methods": [ "GET" ], "Paths": [ "/salesforce/services/data/**" ] }
        ]
      },
      "support-agent": {
        "Keys": [
          { "KeyId": "support-agent-key-1", "KeyHash": "sha256:1a11de59354e7789f4724aeb2e374168f4d23fddc020919c670511f3aedf8f27" }
        ],
        "Operations": [
          { "Route": "salesforce", "Methods": [ "POST" ], "Paths": [ "/salesforce/services/data/v62.0/sobjects/Case" ] }
        ]
      }
    },
    "Credentials": {
      "salesforce": {
        "Type": "OAuthClientCredentials",
        "TokenEndpoint": "http://localhost:5089/services/oauth2/token",
        "ClientAuthentication": "FormPost",
        "ClientId": "credproxdemo",
        "ClientSecret": "secret:sf-client-secret",
        "Scope": "api"
      }
    },
    "Secrets": {
      "sf-client-secret": "sf-demo-client-secret-never-real"
    },
    "Audit": {
      "Enabled": true
    }
  },
  "ReverseProxy": {
    "Routes": {
      "salesforce": {
        "ClusterId": "salesforce",
        "Match": { "Path": "/salesforce/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/salesforce" } ],
        "Metadata": {
          "CredProx.Credential": "salesforce"
        }
      }
    },
    "Clusters": {
      "salesforce": {
        "Destinations": {
          "salesforce": { "Address": "http://localhost:5089/" }
        }
      }
    }
  }
}
