{
  "//": "Loaded by 'dotnet run -- --variant real'. Repoints ADP at its real endpoint and adds the mTLS connection ADP requires. Set the secrets via environment variables or user-secrets — nothing real is committed.",
  "CredProx": {
    "Destinations": {
      "adp": { "Template": "https://api.adp.com" }
    },
    "Connections": {
      "adp-mtls": {
        "ClientCertificate": "secret:adp-cert"
      }
    },
    "Credentials": {
      "adp": {
        "TokenEndpoint": "https://api.adp.com/oauth2/token",
        "ClientId": "",
        "ClientSecret": "secret:adp-secret",
        "Connection": "adp-mtls"
      }
    },
    "Secrets": {
      "adp-secret": "",
      "adp-cert": ""
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "adp": {
        "Destinations": { "adp": { "Address": "https://api.adp.com/" } },
        "Metadata": { "CredProx.Connection": "adp-mtls" }
      }
    }
  }
}
