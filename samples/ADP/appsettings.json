{
  "//": "E6: ADP's shape as pure CredProx config, offline. nginx (mTLS required) fronts a WireMock stub; the client certificate is a base64 passwordless PFX in secrets.d (generate-certs.sh) — the original implementation's adp-auth-cert format. One named connection is presented on BOTH the token call and the API calls. Trust the sample CA when running: SSL_CERT_FILE=$PWD/certs/ca.crt.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CredProx": {
    "Destinations": {
      "adp": { "Template": "https://localhost:8443" }
    },
    "Connections": {
      "adp-mtls": {
        "ClientCertificate": "secret:adpClientCert"
      }
    },
    "Credentials": {
      "adp": {
        "Type": "OAuthClientCredentials",
        "TokenEndpoint": "https://localhost:8443/auth/oauth/v2/token?grant_type=client_credentials",
        "ClientId": "adp-client",
        "ClientSecret": "secret:adpClientSecret",
        "ClientAuthentication": "BasicHeader",
        "Connection": "adp-mtls",
        "TokenTypeName": "Bearer"
      }
    },
    "Secrets": {
      "adpClientSecret": "demoAdpSecret"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "adp": {
        "ClusterId": "adp",
        "Methods": ["GET"],
        "Match": { "Path": "/adp/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/adp" }],
        "Metadata": {
          "CredProx.Destination": "adp",
          "CredProx.Credential": "adp"
        }
      }
    },
    "Clusters": {
      "adp": {
        "Destinations": { "adp": { "Address": "https://localhost:8443/" } },
        "Metadata": { "CredProx.Connection": "adp-mtls" }
      }
    }
  }
}
