{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CredProx": {
    "Destinations": {
      "adp": { "Template": "http://localhost:8081" }
    },
    "Credentials": {
      "adp": {
        "Type": "OAuthClientCredentials",
        "TokenEndpoint": "http://localhost:8081/adp/oauth2/token",
        "ClientId": "adp-client",
        "ClientSecret": "secret:adp-secret",
        "Scope": "workforce",
        "TokenTypeName": "Bearer"
      }
    },
    "Secrets": {
      "adp-secret": "demo-adp-secret"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "adp": {
        "ClusterId": "adp",
        "Match": { "Path": "/adp/{**catch-all}" },
        "Metadata": {
          "CredProx.Destination": "adp",
          "CredProx.Credential": "adp"
        }
      }
    },
    "Clusters": {
      "adp": {
        "Destinations": { "adp": { "Address": "http://localhost:8081/" } }
      }
    }
  }
}
