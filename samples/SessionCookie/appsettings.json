{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CredProx": {
    "Callers": {
      "erp-integration": {
        "Keys": [
          { "KeyId": "erp-key-1", "KeyHash": "sha256:d70d51d866b019530d3e6972210f2cc6f391c8d335ef0b9a3d9722def7a3cdab" }
        ],
        "Operations": [
          { "Route": "crm", "Methods": [ "GET" ], "Paths": [ "/crm/api/**" ] },
          { "Route": "crm-raw", "Methods": [ "GET" ], "Paths": [ "/crm-raw/api/**" ] }
        ]
      }
    },
    "Credentials": {
      "crm": {
        "Type": "LoginExchange",
        "LoginEndpoint": "http://localhost:5095/login?partition={partition}",
        "Method": "POST",
        "Form": { "User": "svc-{partition}", "Password": "secret:crm-{partition}-pass" },
        "Response": "Cookie",
        "ResponseField": "CRMSESSION",
        "Location": "Cookie",
        "Lifetime": "00:55:00",
        "Partition": { "From": "header:X-API-Env", "Allowed": [ "sandbox", "production" ] }
      }
    },
    "Secrets": {
      "crm-sandbox-pass": "crm-demo-sandbox-password-never-real",
      "crm-production-pass": "crm-demo-production-password-never-real"
    },
    "Audit": {
      "Enabled": true
    }
  },
  "ReverseProxy": {
    "Routes": {
      "crm": {
        "ClusterId": "crm",
        "Match": { "Path": "/crm/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/crm" } ],
        "Metadata": {
          "CredProx.Credential": "crm"
        }
      },
      "crm-raw": {
        "ClusterId": "crm",
        "Match": { "Path": "/crm-raw/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/crm-raw" } ],
        "Metadata": {
          "CredProx.Credential": "crm",
          "CredProx.ErrorNormalisation": "off"
        }
      }
    },
    "Clusters": {
      "crm": {
        "Destinations": {
          "crm": { "Address": "http://localhost:5095/" }
        }
      }
    }
  }
}
