{
  "//": "AI provider gateway. Callers authenticate with their own X-CredProx-Key, matched against the SHA-256 KeyHashes under CredProx:Callers; each caller's Operations list is its allow-list (absent = every operation). The provider key is a StaticKey header credential no app ever holds. Per-caller Limits pace one app; Throttling:Clusters paces the provider for everyone. Audit records every call with the caller id, never a key value. Demo keys and the demo provider key are throwaway; real ones go in your secret source.",
  "Urls": "http://localhost:5088",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CredProx": {
    "Callers": {
      "chat-app": {
        "Keys": [
          { "KeyId": "chat-app-key-1", "KeyHash": "sha256:e222c75f317801ce65f0a54a2e7dd61564022839baa0ee3da1de50d19db098dc" }
        ],
        "Operations": [
          { "Route": "ai", "Methods": [ "POST" ], "Paths": [ "/ai/v1/chat/**", "/ai/v1/messages/**" ] }
        ]
      },
      "ops-app": {
        "Keys": [
          { "KeyId": "ops-app-key-1", "KeyHash": "sha256:054ceda36091070721bac9fcaa1e75b47226b9e7231921ac563a9f6ab4eb3cf2" }
        ]
      },
      "batch-app": {
        "Keys": [
          { "KeyId": "batch-app-key-1", "KeyHash": "sha256:d9739d11f9506cc176ceb27946618d977358d7563458ea1e336338c7c15e7d3e" }
        ],
        "Limits": {
          "PermitsPerInterval": 2,
          "Interval": "00:01:00"
        }
      }
    },
    "Destinations": {
      "ai": { "Template": "https://api.openai.com" }
    },
    "Credentials": {
      "ai-provider": {
        "Type": "StaticKey",
        "Secret": "secret:ai-provider-key",
        "Location": "Header",
        "Name": "Authorization",
        "Prefix": "Bearer "
      }
    },
    "Secrets": {
      "ai-provider-key": "sk-credprox-gateway-demo-key"
    },
    "Throttling": {
      "Clusters": {
        "ai": { "PermitsPerInterval": 2, "Interval": "00:00:01", "QueueLimit": 0 }
      }
    },
    "Audit": {
      "Enabled": true
    },
    "Metering": {
      "MaxUsageParseBytes": 1048576
    }
  },
  "Metrics": {
    "//": "Console true prints the CredProx meter to stdout instead of exporting OTLP (the default endpoint OTEL_EXPORTER_OTLP_ENDPOINT). Shorten OTEL_METRIC_EXPORT_INTERVAL (ms, default 60000) for demos.",
    "Console": false
  },
  "ReverseProxy": {
    "Routes": {
      "ai": {
        "ClusterId": "ai",
        "Match": { "Path": "/ai/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/ai" } ],
        "Metadata": {
          "CredProx.Credential": "ai-provider",
          "CredProx.Destination": "ai",
          "CredProx.Metering.Usage": "anthropic"
        }
      }
    },
    "Clusters": {
      "ai": {
        "Destinations": {
          "ai": { "Address": "https://api.openai.com/" }
        }
      }
    }
  }
}
