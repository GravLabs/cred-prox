<?xml version="1.0" encoding="utf-8"?>
<!-- Examples consume CredProx as a package (plan §6 quality bar). Pack locally first:
       dotnet pack src/CredProx -c Release -o artifacts/packages
       dotnet pack src/CredProx.AzureKeyVault -c Release -o artifacts/packages
     Once a version is published to a feed, this file can drop the local source. -->
<configuration>
  <packageSources>
    <add key="credprox-local" value="../artifacts/packages" />
  </packageSources>
</configuration>
