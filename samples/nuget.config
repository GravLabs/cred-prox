<?xml version="1.0" encoding="utf-8"?>
<!-- Examples consume CredProx as a package (the quality bar). Pack every package
     into the local feed first (PUBLISHING.md describes publishing; sample builds need
     only the pack step):
       for p in src/*/; do dotnet pack "$p" -c Release -o artifacts/packages; done
     Once a version is published to a feed, this file can drop the local source. -->
<configuration>
  <packageSources>
    <add key="credprox-local" value="../artifacts/packages" />
  </packageSources>
</configuration>
