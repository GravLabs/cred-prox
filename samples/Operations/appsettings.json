{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CredProx": {
    "Destinations": {
      "limited": { "Template": "http://localhost:8091" },
      "vendor": { "Template": "http://localhost:8091" },
      "flaky": { "Template": "http://localhost:8091" }
    },
    "Credentials": {
      "ops-key": {
        "Type": "StaticKey",
        "Secret": "secret:ops-key",
        "Name": "X-Ops-Key"
      }
    },
    "Secrets": {
      "ops-key": "ops-demo-key"
    },
    "Throttling": {
      "Clusters": {
        "limited": {
          "PermitsPerInterval": 5,
          "Interval": "00:00:01",
          "QueueLimit": 2,
          "MaxQueueWait": "00:00:01"
        },
        "vendor": {
          "PauseOnVendorThrottle": true,
          "MaxQueueWait": "00:00:03",
          "MaxPause": "00:00:10"
        }
      }
    },
    "Resilience": {
      "MaxRetries": 0,
      "Clusters": {
        "flaky": {
          "FailureRatio": 0.5,
          "MinimumThroughput": 4,
          "SamplingDuration": "00:00:10",
          "BreakDuration": "00:00:03"
        }
      }
    },
    "Health": {
      "ProbeInterval": "00:00:05"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "limited": {
        "ClusterId": "limited",
        "Match": { "Path": "/limited/{**catch-all}" },
        "Metadata": {
          "CredProx.Destination": "limited",
          "CredProx.Credential": "ops-key"
        }
      },
      "vendor": {
        "ClusterId": "vendor",
        "Match": { "Path": "/vendor/{**catch-all}" },
        "Metadata": {
          "CredProx.Destination": "vendor",
          "CredProx.Credential": "ops-key"
        }
      },
      "flaky": {
        "ClusterId": "flaky",
        "Match": { "Path": "/flaky/{**catch-all}" },
        "Metadata": {
          "CredProx.Destination": "flaky",
          "CredProx.Credential": "ops-key"
        }
      }
    },
    "Clusters": {
      "limited": {
        "Destinations": { "limited": { "Address": "http://localhost:8091/" } }
      },
      "vendor": {
        "Destinations": { "vendor": { "Address": "http://localhost:8091/" } }
      },
      "flaky": {
        "Destinations": { "flaky": { "Address": "http://localhost:8091/" } }
      }
    }
  }
}
