<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Examples use the experimental contract on purpose. -->
    <NoWarn>$(NoWarn);CREDPROX001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- StubApi/ is its own project; keep its files out of this compilation. -->
    <Compile Remove="StubApi/**" />
    <Content Remove="StubApi/**" />
    <None Remove="StubApi/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CredProx" />
    <!-- The plugin author's testing kit: the conformance class in this folder is
         ordinary sample code — a plugin ships the same in its own test project. -->
    <PackageReference Include="CredProx.Testing" />
    <PackageReference Include="xunit" />
  </ItemGroup>

</Project>
