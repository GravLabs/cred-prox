<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Examples use the experimental contract on purpose. -->
    <NoWarn>$(NoWarn);CREDPROX001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CredProx" />
    <!-- The plugin author's testing kit (plan §5 "Testing kit"): the conformance class
         below is ordinary sample code — a plugin ships the same in its own test project. -->
    <PackageReference Include="CredProx.Testing" />
    <PackageReference Include="xunit" />
  </ItemGroup>

</Project>
