{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CredProx": {
    "Destinations": {
      "vendor": { "Template": "https://vendor.example.com" }
    },
    "Credentials": {
      "vendor-session": {
        "Type": "VendorSession",
        "LoginEndpoint": "https://vendor.example.com/login",
        "AppId": "",
        "Secret": "secret:vendor-secret",
        "Name": "X-Session-Id"
      }
    },
    "Secrets": {
      "vendor-secret": ""
    }
  },
  "ReverseProxy": {
    "Routes": {
      "vendor": {
        "ClusterId": "vendor",
        "Match": { "Path": "/vendor/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/vendor" }
        ],
        "Metadata": {
          "CredProx.Destination": "vendor",
          "CredProx.Credential": "vendor-session"
        }
      }
    },
    "Clusters": {
      "vendor": {
        "Destinations": {
          "vendor": { "Address": "https://vendor.example.com/" }
        }
      }
    }
  }
}
