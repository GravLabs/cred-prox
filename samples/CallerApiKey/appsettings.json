{
  "//": "E18: callers present X-API-Key; CredProx validates SHA-256 hashes from a secret-backed store and strips the header before forwarding. The committed hash is of the DEMO key only — real hashes live in your secret store (env: CredProx__Secrets__demoAppKeyHash), format sha256:<64 hex>.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CredProx": {
    "CallerAuth": {
      "HeaderName": "X-API-Key"
    },
    "Callers": {
      "demo-app": {
        "Keys": [
          { "KeyId": "key-1", "KeyHash": "secret:demoAppKeyHash" }
        ]
      }
    },
    "Secrets": {
      "demoAppKeyHash": "sha256:52f42591c2dee3d4099ed6b329b09a416c31c0c1e0f68a1d7db0f0e9b6f8e654"
    },
    "Destinations": {
      "upstream": { "Template": "http://localhost:8081" }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "data": {
        "ClusterId": "upstream",
        "Match": { "Path": "/api/{**catch-all}" },
        "Metadata": { "CredProx.Destination": "upstream" }
      }
    },
    "Clusters": {
      "upstream": {
        "Destinations": { "upstream": { "Address": "http://localhost:8081/" } }
      }
    }
  }
}
