{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CredProx": {
    "Callers": {
      "app-a": {
        "Keys": [
          { "KeyId": "app-a-key-1", "KeyHash": "sha256:9743f3dc7e79656516f9e24981dc4c3a613c45480c93ed4dffa9dfd936b5895b" }
        ]
      }
    },
    "Destinations": {
      "api": { "Template": "http://api:8080" }
    },
    "Credentials": {
      "downstream": {
        "Type": "TokenExchange",
        "Mode": "Rfc8693",
        "Issuer": "http://keycloak:8080/realms/credprox",
        "JwksUri": "http://keycloak:8080/realms/credprox/protocol/openid-connect/certs",
        "Audience": "credprox-proxy",
        "TokenEndpoint": "http://keycloak:8080/realms/credprox/protocol/openid-connect/token",
        "ClientId": "credprox-proxy",
        "ClientSecret": "secret:keycloak-proxy-secret",
        "RequestedAudience": "credprox-downstream"
      }
    },
    "Secrets": {
      "keycloak-proxy-secret": "credprox-proxy-secret"
    },
    "Audit": {
      "Enabled": true
    }
  },
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "api",
        "Match": { "Path": "/{**catch-all}" },
        "Metadata": {
          "CredProx.Destination": "api",
          "CredProx.Credential": "downstream"
        }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "api": { "Address": "http://api:8080/" }
        }
      }
    }
  }
}
