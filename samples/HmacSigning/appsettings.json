{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CredProx": {
    "Destinations": {
      "vendor": {
        "Template": "http://localhost:5080"
      }
    },
    "Credentials": {
      "signer": {
        "Type": "Hmac",
        "Secret": "secret:hmac-key",
        "Algorithm": "SHA256",
        "Encoding": "HexLower",
        "Components": [ "method", "path", "timestamp", "bodyHash" ],
        "Separator": "\n",
        "TimestampFormat": "UnixSeconds",
        "SignatureHeader": "X-Signature",
        "TimestampHeader": "X-Timestamp",
        "BufferBody": true,
        "MaxBodyBytes": 1048576
      },
      "signer-small": {
        "Type": "Hmac",
        "Secret": "secret:hmac-key",
        "Components": [ "method", "path", "timestamp", "bodyHash" ],
        "SignatureHeader": "X-Signature",
        "TimestampHeader": "X-Timestamp",
        "BufferBody": true,
        "MaxBodyBytes": 16
      }
    },
    "Secrets": {
      "hmac-key": "demo-shared-key"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "vendor",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ],
        "Metadata": {
          "CredProx.Destination": "vendor",
          "CredProx.Credential": "signer"
        }
      },
      "small": {
        "ClusterId": "vendor",
        "Match": {
          "Path": "/small/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/small" }
        ],
        "Metadata": {
          "CredProx.Destination": "vendor",
          "CredProx.Credential": "signer-small"
        }
      }
    },
    "Clusters": {
      "vendor": {
        "Destinations": {
          "vendor": {
            "Address": "http://localhost:5080/"
          }
        }
      }
    }
  }
}
