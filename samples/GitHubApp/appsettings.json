{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CredProx": {
    "Destinations": {
      "github": {
        "Template": "https://api.github.com"
      }
    },
    "Credentials": {
      "github-app": {
        "Type": "JwtAssertion",
        "Algorithm": "RS256",
        "SigningKey": "secret:github-app-signing-key",
        "Audience": "https://api.github.com",
        "Lifetime": "00:09:00",
        "Exchange": "BearerExchange",
        "TokenField": "token",
        "ExpiresAtField": "expires_at",
        "Issuer": "123456",
        "TokenEndpoint": "https://api.github.com/app/installations/789012/access_tokens"
      }
    },
    "Secrets": {
      "github-app-signing-key": ""
    }
  },
  "ReverseProxy": {
    "Routes": {
      "github": {
        "ClusterId": "github",
        "Match": {
          "Path": "/github/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/github" }
        ],
        "Metadata": {
          "CredProx.Destination": "github",
          "CredProx.Credential": "github-app"
        }
      }
    },
    "Clusters": {
      "github": {
        "Destinations": {
          "github": {
            "Address": "https://api.github.com/"
          }
        }
      }
    }
  }
}
