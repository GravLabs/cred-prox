{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CredProx": {
    "Connections": {
      "mtls": {
        "ClientCertificate": "secret:client-cert"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "upstream": {
        "ClusterId": "upstream",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "upstream": {
        "Destinations": {
          "upstream": {
            "Address": "https://localhost:8443/"
          }
        },
        "Metadata": {
          "CredProx.Connection": "mtls"
        }
      }
    }
  }
}
