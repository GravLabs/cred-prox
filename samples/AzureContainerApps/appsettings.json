{
  "//": "AzureContainerApps: the Azure Container Apps deployment host. Callers present X-API-Key, validated against a SHA-256 hash held as a secret reference; the vendor key is a secret: reference. With KeyVault__Uri set the Key Vault provider answers both through the app's managed identity; unset, they come from plain config (env/user-secrets) like every other sample. The committed values are the offline demo pair only; real ones live in your Key Vault (README.md).",
  "Urls": "http://localhost:5097",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CredProx": {
    "CallerAuth": {
      "HeaderName": "X-API-Key"
    },
    "Callers": {
      "aca-demo": {
        "Keys": [
          { "KeyId": "key-1", "KeyHash": "secret:demoCallerKeyHash" }
        ]
      }
    },
    "Credentials": {
      "acme": {
        "Type": "StaticKey",
        "Secret": "secret:acme-vendor-key",
        "Location": "Header",
        "Name": "Authorization",
        "Prefix": "Bearer "
      }
    },
    "Secrets": {
      "demoCallerKeyHash": "sha256:954acd16a0e2a16f511105ddde4778561c64b438e15b9f73a235fe647bd62f26",
      "acme-vendor-key": "credprox-aca-demo-vendor-key-never-real"
    },
    "Destinations": {
      "acme": { "Template": "http://localhost:8098" }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "acme": {
        "ClusterId": "acme",
        "Match": { "Path": "/acme/{**catch-all}" },
        "Metadata": {
          "CredProx.Destination": "acme",
          "CredProx.Credential": "acme"
        }
      }
    },
    "Clusters": {
      "acme": {
        "Destinations": {
          "acme": { "Address": "http://localhost:8098/" }
        }
      }
    }
  }
}
