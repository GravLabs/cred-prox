{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CredProx": {
    "Destinations": {
      "arm": { "Template": "https://management.azure.com" },
      "cp": { "Template": "http://localhost:8082" },
      "cpmtls": { "Template": "https://localhost:8443" }
    },
    "Credentials": {
      "arm": {
        "Type": "TokenCredential",
        "Scope": "https://management.azure.com/.default"
      },
      "jwt": {
        "Type": "JwtAssertion",
        "Algorithm": "RS256",
        "SigningKey": "secret:jwt-signing-key",
        "Issuer": "credprox-m29",
        "Audience": "http://credprox-m29-counterparty",
        "Lifetime": "00:09:00",
        "Exchange": "BearerExchange",
        "TokenField": "token",
        "ExpiresAtField": "expires_at",
        "TokenEndpoint": "http://localhost:8082/app/token"
      },
      "hmac": {
        "Type": "Hmac",
        "Secret": "secret:hmac-key",
        "Algorithm": "SHA256",
        "Encoding": "HexLower",
        "Components": [ "method", "path", "timestamp", "bodyHash" ],
        "Separator": "\n",
        "TimestampFormat": "UnixSeconds",
        "SignatureHeader": "X-Signature",
        "TimestampHeader": "X-Timestamp",
        "BufferBody": true,
        "MaxBodyBytes": 1048576
      }
    },
    "Connections": {
      "mtls": {
        "ClientCertificate": "secret:mtls-client-cert",
        "ClientCertificatePassword": "secret:mtls-client-cert-password"
      }
    },
    "Secrets": {
      "jwt-signing-key": "",
      "hmac-key": "",
      "mtls-client-cert": "",
      "mtls-client-cert-password": ""
    }
  },
  "ReverseProxy": {
    "Routes": {
      "arm": {
        "ClusterId": "arm",
        "Match": { "Path": "/arm/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/arm" } ],

        "Metadata": {
          "CredProx.Destination": "arm",
          "CredProx.Credential": "arm"
        }
      },
      "jwt": {
        "ClusterId": "cp",
        "Match": { "Path": "/jwt/{**catch-all}" },
        "Metadata": {
          "CredProx.Destination": "cp",
          "CredProx.Credential": "jwt"
        }
      },
      "hmac": {
        "ClusterId": "cp",
        "Match": { "Path": "/hmac/{**catch-all}" },
        "Metadata": {
          "CredProx.Destination": "cp",
          "CredProx.Credential": "hmac"
        }
      },
      "mtls": {
        "ClusterId": "cpmtls",
        "Match": { "Path": "/mtls/{**catch-all}" },
        "Metadata": {
          "CredProx.Destination": "cpmtls"
        }
      }
    },
    "Clusters": {
      "arm": {
        "Destinations": { "arm": { "Address": "https://management.azure.com/" } }
      },
      "cp": {
        "Destinations": { "cp": { "Address": "http://localhost:8082/" } }
      },
      "cpmtls": {
        "Destinations": { "cp": { "Address": "https://localhost:8443/" } },
        "Metadata": {
          "CredProx.Connection": "mtls"
        }
      }
    }
  }
}
