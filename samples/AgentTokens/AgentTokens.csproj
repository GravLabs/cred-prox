<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Examples use the experimental contract on purpose. -->
    <NoWarn>$(NoWarn);CREDPROX001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Agent/ is its own project; keep its files out of this compilation. -->
    <Compile Remove="Agent/**" />
    <Content Remove="Agent/**" />
    <None Remove="Agent/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CredProx" />
    <PackageReference Include="CredProx.Identity" />
    <PackageReference Include="CredProx.Operations" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
  </ItemGroup>

</Project>
