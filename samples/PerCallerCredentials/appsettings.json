{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CredProx": {
    "Callers": {
      "app-a": {
        "Keys": [
          { "KeyId": "app-a-key-1", "KeyHash": "sha256:dcb3aef7725465b634cf2e9f90b64dcbc99acfa09ee548071ce239b19c8f5ede" }
        ]
      },
      "app-b": {
        "Keys": [
          { "KeyId": "app-b-key-1", "KeyHash": "sha256:79581a6faf7c817949d5b28e6d65b86612099721b550c8cabbc39d84b35fcbf6" }
        ]
      },
      "app-readonly": {
        "Keys": [
          { "KeyId": "readonly-key-1", "KeyHash": "sha256:be4539ba5f8f934219ac7e475deb280684808eef963a20dcfa918d7104b30aac" }
        ],
        "Operations": [
          { "Route": "api", "Methods": [ "GET" ] }
        ]
      }
    },
    "Destinations": {
      "api": { "Template": "http://api:8080" }
    },
    "Credentials": {
      "keycloak": {
        "Type": "OAuthClientCredentials",
        "TokenEndpoint": "http://keycloak:8080/realms/credprox/protocol/openid-connect/token",
        "ClientId": "credprox-{partition}",
        "ClientSecret": "secret:keycloak-{partition}-secret",
        "TokenTypeName": "Bearer",
        "Partition": {
          "From": "caller:",
          "Allowed": [ "app-a", "app-b", "app-readonly" ]
        }
      }
    },
    "Secrets": {
      "keycloak-app-a-secret": "credprox-app-a-secret",
      "keycloak-app-b-secret": "credprox-app-b-secret",
      "keycloak-app-readonly-secret": "credprox-app-readonly-secret"
    },
    "Audit": {
      "Enabled": true
    }
  },
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "api",
        "Match": { "Path": "/{**catch-all}" },
        "Metadata": {
          "CredProx.Destination": "api",
          "CredProx.Credential": "keycloak"
        }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "api": { "Address": "http://api:8080/" }
        }
      }
    }
  }
}
