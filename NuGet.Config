<?xml version="1.0" encoding="utf-8"?>
<!-- Central package management (Directory.Packages.props) requires package source
     mapping whenever more than one source is in play (NU1507, an error here because
     warnings are errors). This repo-level config stays reachable from anywhere:
     nuget.org plus the CI-local feed. The CredProx package registry is NOT declared
     here — its URL is machine-local; publishing machines declare the `credprox`
     source (with its push token) in their user-level NuGet config, per PUBLISHING.md.
     PackageValidation no longer restores its baseline from a feed at all: the
     baseline packages are committed under build/baselines (docs/adr/0001).
     `credprox-local` (artifacts/packages) is added per-folder by samples/nuget.config. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="credprox-local">
      <package pattern="CredProx*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
