<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Property/security tests run on the newest LTS only, like the unit tests. -->
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Tests use the experimental contract on purpose. -->
    <NoWarn>$(NoWarn);CREDPROX001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FsCheck.Xunit" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CredProx\CredProx.csproj" />
    <ProjectReference Include="..\..\src\CredProx.Abstractions\CredProx.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The features run against a real HttpContext. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
