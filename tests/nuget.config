<?xml version="1.0" encoding="utf-8"?>
<!-- The test projects declare their own CredProx source (same shape as
     samples/nuget.config). Without it the repo mapping routes CredProx* to the
     credprox-local key that only samples/nuget.config declares, so a test project
     restores only from whatever exact version the samples' build last dropped into
     the machine cache — an exact-version cache hit is never re-verified against a
     source, and stale library bytes pass the smokes silently. xunit and friends
     keep coming from nuget.org via the repo-level mapping. -->
<configuration>
  <packageSources>
    <add key="credprox-local" value="../artifacts/packages" />
  </packageSources>
</configuration>
