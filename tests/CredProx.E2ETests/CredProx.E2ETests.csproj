<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Container end-to-end tests (plan §5.1): real Keycloak, real nginx mTLS.
         Newest LTS only; they run on Linux with Docker and skip elsewhere. -->
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Tests use the experimental contract on purpose. -->
    <NoWarn>$(NoWarn);CREDPROX001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.Keycloak" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CredProx\CredProx.csproj" />
    <ProjectReference Include="..\..\src\CredProx.Abstractions\CredProx.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests host the proxy in an in-process ASP.NET Core server. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
