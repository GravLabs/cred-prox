  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CredProx.Testing\CredProx.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
